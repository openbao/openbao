<div data-test-secret-subkeys>
  {{#each this.keys key="id" as |key index|}}
    <InfoTableRow
      class="secret-key-row is-align-items-flex-start"
      @label={{key.label}}
      @alwaysRender={{true}}
      data-test-secret-subkey={{key.label}}
    >
      <:labelFooter>
        {{#if key.spaceWarning}}
          <AlertInline @type="warning" @size="small" @isMarginless={{true}} @message={{key.spaceWarning}} />
        {{/if}}
      </:labelFooter>
      <:default>
        <div class="is-fullwidth">
          {{#if (eq this.editingKey key.id)}}
            <form {{on "submit" (fn this.save key)}} data-test-patch-subkey-form>
              <fieldset disabled={{this.isSaving}}>
                <div class="field">
                  <MaskedInput
                    @name={{key.label}}
                    @ariaLabel="New value for {{key.label}}"
                    @value={{this.newValue}}
                    @onChange={{fn (mut this.newValue)}}
                    data-test-patch-subkey-value
                  />
                </div>
                <div class="field">
                  <label class="checkbox">
                    <Input @type="checkbox" @checked={{this.jsonValue}} data-test-patch-subkey-json />
                    Use JSON value
                  </label>
                </div>
                <div class="buttons">
                  <button class="button is-primary is-small" type="submit" data-test-patch-subkey-save>Save</button>
                  <button class="button is-small" type="button" {{on "click" this.cancel}}>Cancel</button>
                </div>
              </fieldset>
            </form>
          {{else}}
            <MaskedInput
              @name={{key.label}}
              @value={{get this.displayedValues index}}
              @displayOnly={{true}}
              @onReveal={{@onReveal}}
              @allowCopy={{@values}}
              @allowDownload={{@values}}
            >
              {{#if @data.patchVersion}}
                <div class="secret-key-row-actions">
                  <button
                    type="button"
                    class="button secret-key-row-action"
                    aria-label="Edit {{key.label}}"
                    title="Edit {{key.label}}"
                    disabled={{or this.isSaving this.editingKey}}
                    {{on "click" (fn this.edit key)}}
                    data-test-patch-subkey
                  >
                    <Icon @name="edit" aria-hidden="true" />
                  </button>
                  <ConfirmAction
                    @buttonClasses="button secret-key-row-action"
                    @triggerLabel="Delete {{key.label}}"
                    @confirmTitle="Delete {{key.label}}?"
                    @confirmMessage="This creates a new version with the selected subkey removed."
                    @onConfirmAction={{fn this.patch @data key null}}
                    @disabled={{or this.isSaving this.editingKey}}
                    data-test-patch-subkey-delete
                  >
                    <Icon @name="trash" aria-hidden="true" />
                  </ConfirmAction>
                </div>
              {{/if}}
            </MaskedInput>
          {{/if}}
          {{#if (eq this.error.key key.id)}}
            <MessageError @errorMessage={{this.error.message}} />
          {{/if}}
        </div>
      </:default>
    </InfoTableRow>
  {{else}}
    <InfoTableRow @alwaysRender={{true}}>This version has no keys.</InfoTableRow>
  {{/each}}
</div>