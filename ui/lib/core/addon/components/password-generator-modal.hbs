<Modal @title="Generate Password" @onClose={{@onClose}} @isActive={{true}} @showCloseButton={{true}}>
  <section class="modal-card-body" data-test-password-generator>
    <div class="field">
      <span class="is-label">Preview</span>
      <div class="password-generator-preview">
        <code class="is-word-break" data-test-password-preview>{{this.pw}}</code>
        <button
          type="button"
          class="button is-compact"
          title="Regenerate"
          aria-label="Regenerate"
          {{on "click" this.regenerate}}
          disabled="{{this.error}}"
          data-test-password-regenerate
        >
          <Icon @name="reload" />
        </button>
      </div>
    </div>

    <div class="field">
      <label for="{{this.idPrefix}}-length" class="is-label">Length</label>
      <input
        id="{{this.idPrefix}}-length"
        class="input password-generator-length"
        type="number"
        min={{this.minLength}}
        max={{this.maxLength}}
        value={{this.length}}
        {{on "input" this.setLength}}
        data-test-password-length
      />
    </div>

    <fieldset class="field form-fieldset">
      <legend class="is-label">Include</legend>
      {{#each this.typeOptions as |option|}}
        <div class="b-checkbox">
          <input
            type="checkbox"
            id="{{this.idPrefix}}-{{option.key}}"
            class="styled"
            checked={{get this.types option.key}}
            {{on "change" (fn this.toggleType option.key)}}
            data-test-password-type={{option.key}}
          />
          <label for="{{this.idPrefix}}-{{option.key}}" class="is-label">{{option.label}}</label>
        </div>
      {{/each}}
    </fieldset>

    {{#if this.error}}
      <AlertInline @type="danger" @message="{{this.error}}" data-test-password-error />
    {{/if}}
  </section>

  <footer class="modal-card-foot modal-card-foot-outlined">
    <button
      class="button is-primary"
      type="button"
      disabled={{this.error}}
      {{on "click" this.use}}
      data-test-password-use
    >Use password</button>
    <button class="button is-secondary" type="button" {{on "click" @onClose}} data-test-password-cancel>Cancel</button>
  </footer>

</Modal>